# Firma del APK. Guárdala junto a las copias de seguridad: si se pierde, no se
# puede instalar encima y hay que desinstalar, lo que BORRA los datos de la app.
*.jks
*.p8
*.p12
*.key
*.keystore
*.mobileprovision
keystore.properties

# Copias de seguridad: pueden llevar fotos y datos personales. Nunca al repo.
ludok-wallet-backup-*.json

# Datos tirados de un móvil real para migrar desde la versión de Flutter.
migracion-flutter/

